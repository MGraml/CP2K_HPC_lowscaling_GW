DFLAGS      = -D__LIBXSMM  -D__parallel -D__MPI_F08 -D__FFTW3  -D__LIBINT -D__LIBXC -D__LIBGRPP -D__parallel -D__COSMA -D__ELPA  -D__GSL -D__PLUMED2 -D__HDF5 -D__LIBVDWXC -D__SPGLIB -D__LIBVORI -D__SPFFT    -D__SPLA -D__SIRIUS -D__DBCSR  
